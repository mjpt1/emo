CONFIG_BOARD_TYPE_OTTO_ROBOT=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/v2/16m.csv"
CONFIG_LVGL_USE_GIF=y
# Custom wake word "Mochi" (MultiNet7) disabled: ran internal SRAM down to 16 bytes -> freezes.
